# =============================================================================
# Vee Care — environment template (no real secrets)
# Copy to .env.local / Coolify. Plain Postgres cutover vars included.
# =============================================================================

NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://veecare.shop

# Plain Postgres (from: sudo fleet db provision / store_veecare.env)
DATABASE_URL=postgresql://store_veecare:CHANGE_ME@fleet-postgres:5432/store_veecare
# Prefer fleet-postgres:5432 over pgbouncer for this app (IPv6/pooler issues observed).
PG_POOL_MAX=10
PGSSL=
NEXT_PUBLIC_USE_PLAIN_PG=true

# Browser SDK must hit THIS app (shims), not *.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://veecare.shop
NEXT_PUBLIC_SUPABASE_ANON_KEY=any-nonempty-anon-string
SUPABASE_SERVICE_ROLE_KEY=strong-random-service-role-string

AUTH_JWT_SECRET=generate-a-long-random-secret
STORAGE_ROOT=/data/veecare/storage
STORAGE_PUBLIC_URL=https://veecare.shop
STORAGE_SIGNING_SECRET=generate-a-long-random-secret

# Payments / SMS / email
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_CALLBACK_SECRET=
MOOLRE_MERCHANT_EMAIL=
MOOLRE_SMS_API_KEY=
MOOLRE_SMS_SENDER_ID=VEECARE
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MERCHANT_EMAIL=
RESEND_API_KEY=
# Sender address (Resend "from"). Recipients for new-order alerts use ADMIN_EMAIL only.
EMAIL_FROM=Vee Care Hera <info@veecare.shop>
ADMIN_EMAIL=tinabrummie@gmail.com,veecare@veecarehera.com
PRODUCT_SKU_PREFIX=VEECARE
GROQ_API_KEY=
